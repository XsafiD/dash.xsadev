# ── Template production — copy ke .env.production DI SERVER, isi nilai nyata ──
#   cp .env.production.example .env.production && chmod 600 .env.production
# File ini di-commit TANPA nilai rahasia. .env.production sudah di-gitignore.
# Nilai $(...) TIDAK diekspansi oleh compose/dotenv — generate dulu, tempel hasil literal.

# ── Database (dibaca aplikasi) — nilai HARUS sama dengan MYSQL_* di bawah ──
DB_NAME=dashxsadev_prod
DB_USER=dashxsadev_user
DB_PASS=<password-kuat-random>
# DB_HOST/DB_PORT tidak perlu — di-override compose ke 'mysql'

# ── Database (init container MySQL) ──
MYSQL_ROOT_PASSWORD=<root-password-kuat-random>
MYSQL_DATABASE=dashxsadev_prod
MYSQL_USER=dashxsadev_user
MYSQL_PASSWORD=<password-kuat-random>   # WAJIB samakan dengan DB_PASS di atas

# ── Flask ──
# Generate: openssl rand -hex 32
SECRET_KEY=<hasil-openssl-rand-hex-32>
DEBUG=false

# ── Hardening session (HTTPS pasti di kedua jalur akses) ──
SESSION_COOKIE_SECURE=true
